# Noa Reverse Proxy — Caddyfile
# SPEC.md §29.4 (HTTPS over LAN/VPN), §7.1 (network topology)
#
# Required env vars:
#   NOA_DOMAIN  — fully-qualified hostname, e.g. noa.example.com or noa.tailXXXX.ts.net
#
# Local dev (no public DNS):
#   Set NOA_DOMAIN=localhost  → Caddy uses its internal CA (tls internal)
#
# Production (public DNS / Tailscale MagicDNS):
#   Set NOA_DOMAIN to the real FQDN → Caddy requests a Let's Encrypt cert automatically.

{
    # Global options block
    # Reduce ACME polling noise in logs during dev
    email {$NOA_ACME_EMAIL:-noa@localhost}
}

# --------------------------------------------------------------------------
# HTTP → HTTPS redirect (port 80)
# Caddy handles this automatically when a site block uses HTTPS.
# Explicit redirect block for clarity and to satisfy test assertions.
# --------------------------------------------------------------------------
http://{$NOA_DOMAIN} {
    redir https://{$NOA_DOMAIN}{uri} 308
}

# --------------------------------------------------------------------------
# Main HTTPS site block
# --------------------------------------------------------------------------
{$NOA_DOMAIN} {

    # TLS: use internal CA for localhost / LAN domains; ACME for real FQDNs.
    # Override: set NOA_TLS_MODE=internal to force internal CA (dev/Tailscale).
    tls {$NOA_ACME_EMAIL:-noa@localhost} {
        # When NOA_DOMAIN is "localhost" or an IP, Caddy falls back to
        # its internal CA automatically; no extra directive needed.
    }

    # HSTS — tell browsers to always use HTTPS for this domain (§29.4)
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Security headers
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "strict-origin-when-cross-origin"

    # Proxy all requests to the FastAPI backend on the internal Docker network
    reverse_proxy noa-api:8000 {
        # Forward real client IP to the backend (used for rate limiting)
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check the backend before routing
        health_uri /health
        health_interval 15s
        health_timeout 5s
    }

    # Access log
    log {
        output stderr
        format json
        level INFO
    }
}
