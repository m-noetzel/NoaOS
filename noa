#!/usr/bin/env bash
# noa — CLI launcher for Noa personal AI agent
# Install: ln -sf "$(pwd)/noa" /usr/local/bin/noa
set -euo pipefail

# Resolve symlink to find the real project directory
SCRIPT_PATH="$0"
if [[ -L "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
fi
NOA_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
cd "$NOA_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log()  { echo -e "${CYAN}▸${NC} $*"; }
ok()   { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }
err()  { echo -e "${RED}✗${NC} $*" >&2; }

usage() {
    echo -e "${BOLD}noa${NC} — governed personal AI agent"
    echo
    echo -e "${BOLD}Usage:${NC}"
    echo "  noa                  Start all services (default)"
    echo "  noa up               Start all services"
    echo "  noa down             Stop all services"
    echo "  noa restart          Restart all services"
    echo "  noa status           Show service status and health"
    echo "  noa logs [service]   Tail logs (all or specific service)"
    echo "  noa health           Run health checks"
    echo "  noa backup           Trigger manual backup"
    echo "  noa test             Run test suite"
    echo "  noa preflight        Run pre-flight checks only"
    echo "  noa setup            First-time setup (build images, verify keychain)"
    echo "  noa shell [service]  Open shell in a container"
    echo "  noa dev              Dev mode (backend containers + Vite UI with hot reload)"
    echo "  noa dev-full         Full dev stack in Docker (dev + postgres + API)"
    echo "  noa dev-full workers Same + private-worker + external-worker"
    echo "  noa dev-full down    Stop dev-full stack"
    echo "  noa dev-full build   Rebuild dev-full images"
    echo "  noa claude           Start Claude Code in the dev container"
    echo "  noa claude build     Rebuild dev container (updates Claude Code)"
    echo "  noa reset-password <email> [pw]  Reset a user's password"
    echo "  noa db migrate       Run database migrations"
    echo "  noa db console       Open psql console"
    echo "  noa migrate-volume [dev|prod]  Migrate data from old postgres volume"
    echo
}

# ── Keychain → shell environment ──────────────────────────────────
# Reads secrets from macOS Keychain and exports them as env vars.
# No file is written to disk. Docker Compose reads ${VAR} from the
# shell environment at runtime.

# Format: "keychain_account_name:ENV_VAR_NAME"
# Account names match what's stored in macOS Keychain under service "noa"
KEYCHAIN_MAP=(
    "SECRET_KEY:SECRET_KEY"
    "JWT_SECRET:JWT_SECRET"
    "POSTGRES_PASSWORD:POSTGRES_PASSWORD"
    "BACKUP_PASSPHRASE:BACKUP_PASSPHRASE"
    "ANTHROPIC_API_KEY:ANTHROPIC_API_KEY"
    "OPENAI_API_KEY:OPENAI_API_KEY"
    "GOOGLE_AI_API_KEY:GOOGLE_AI_API_KEY"
    "GOOGLE_CLIENT_ID:GOOGLE_CLIENT_ID"
    "GOOGLE_CLIENT_SECRET:GOOGLE_CLIENT_SECRET"
    "NOTION_TOKEN:NOTION_TOKEN"
    "TAVILY_API_KEY:TAVILY_API_KEY"
)

load_keychain() {
    if [[ "$(uname)" != "Darwin" ]]; then
        warn "Not on macOS — Keychain not available"
        return 1
    fi

    local loaded=0
    local missing=0

    for pair in "${KEYCHAIN_MAP[@]}"; do
        local kc_name="${pair%%:*}"
        local env_name="${pair##*:}"

        local value
        value=$(security find-generic-password -s "noa" -a "$kc_name" -w 2>/dev/null) || true

        if [[ -n "$value" ]]; then
            export "$env_name=$value"
            loaded=$((loaded + 1))
        else
            missing=$((missing + 1))
        fi
    done

    ok "Keychain: ${loaded} secrets loaded, ${missing} not set"
}

# ── Pre-flight checks ────────────────────────────────────────────

preflight() {
    local errors=0

    # Docker
    if ! command -v docker &>/dev/null; then
        err "Docker not installed"; return 1
    fi
    if ! docker compose version &>/dev/null; then
        err "Docker Compose v2 not available"; return 1
    fi
    ok "Docker Compose $(docker compose version --short)"

    # Load secrets from Keychain
    if ! load_keychain; then
        err "Cannot load secrets from Keychain"
        errors=1
    fi

    # Required secrets
    for var in SECRET_KEY POSTGRES_PASSWORD BACKUP_PASSPHRASE; do
        if [[ -z "${!var:-}" ]]; then
            err "${var} not in Keychain — run: ./tools/keychain_store.sh set ${var} <value>"
            errors=1
        fi
    done

    return $errors
}

# ── First-time setup ─────────────────────────────────────────────

cmd_setup() {
    log "First-time setup for Noa"
    echo

    # Check Keychain
    load_keychain

    # Auto-generate required secrets if not in Keychain
    local pg_password_is_new=false
    for kc_name in SECRET_KEY JWT_SECRET POSTGRES_PASSWORD BACKUP_PASSPHRASE; do
        # Check directly in Keychain (don't trust env vars)
        if security find-generic-password -s "noa" -a "$kc_name" -w &>/dev/null; then
            ok "${kc_name} already in Keychain"
        else
            log "Generating ${kc_name}..."
            local generated
            generated=$(openssl rand -base64 32)
            if ./tools/keychain_store.sh set "$kc_name" "$generated"; then
                export "$kc_name=$generated"
                ok "Generated ${kc_name} → Keychain"
                [[ "$kc_name" == "POSTGRES_PASSWORD" ]] && pg_password_is_new=true
            else
                err "Failed to store ${kc_name} in Keychain"
                warn "You may need to allow Keychain access in the macOS dialog"
            fi
        fi
    done

    # If we just generated a new Postgres password but an existing DB volume
    # has the OLD password, Postgres will reject connections.
    # The check in cmd_up() handles this automatically via ALTER USER,
    # so no special action is needed here.

    # Remove stale .env.secrets if it exists
    if [[ -f .env.secrets ]]; then
        rm -f .env.secrets
        ok "Removed .env.secrets (secrets now come from Keychain only)"
    fi

    # Build images
    echo
    log "Building Docker images (this may take a few minutes)..."
    docker compose build --no-cache
    ok "Docker images built"

    echo
    ok "Setup complete. Start Noa with: ${BOLD}noa${NC}"
}

# ── Commands ─────────────────────────────────────────────────────

# Shared helper: start postgres, sync password to Keychain value, stop again.
# Postgres only reads POSTGRES_PASSWORD during initial volume creation (initdb).
# If the Keychain password changes afterwards the DB still has the old one.
# This is idempotent — if the password already matches it's a harmless no-op.
sync_postgres_password() {
    log "Syncing Postgres password with Keychain..."
    docker compose up -d postgres &>/dev/null
    local pg_ready=false
    for i in $(seq 1 15); do
        if docker compose exec -T postgres pg_isready -U noa &>/dev/null; then
            pg_ready=true
            break
        fi
        sleep 1
    done
    if [[ "$pg_ready" == "true" ]]; then
        local escaped_pw
        escaped_pw=$(printf '%s' "$POSTGRES_PASSWORD" | sed "s/'/''/g")
        if docker compose exec -T postgres \
                psql -U noa -d noa -c "ALTER USER noa PASSWORD '${escaped_pw}'" &>/dev/null; then
            ok "Postgres password synced"
        else
            err "Failed to sync Postgres password"
        fi
        docker compose stop postgres &>/dev/null || true
    else
        warn "Postgres didn't start in time — continuing anyway"
        docker compose stop postgres &>/dev/null || true
    fi
}

cmd_up() {
    log "Running pre-flight checks..."
    if ! preflight; then
        err "Pre-flight failed. Run 'noa setup' first."
        exit 1
    fi
    echo

    sync_postgres_password

    # Ensure the named postgres volume exists (survives 'down -v')
    if ! docker volume inspect noa-pgdata &>/dev/null; then
        log "Creating persistent postgres volume..."
        docker volume create noa-pgdata
        ok "Volume noa-pgdata created"
    fi

    log "Starting Noa..."
    docker compose up -d
    echo
    # Wait for API health
    log "Waiting for services to become healthy..."
    local retries=0
    while [[ $retries -lt 30 ]]; do
        if curl -sf http://localhost:8000/health &>/dev/null; then
            echo
            ok "Noa is running at ${BOLD}http://localhost:8000${NC}"

            # Auto-run migrations to ensure DB schema is up to date
            log "Running database migrations..."
            if docker compose exec -T noa-api alembic upgrade head &>/dev/null; then
                ok "Database migrations up to date"
            else
                warn "Migrations failed — run 'noa db migrate' manually"
            fi

            cmd_status_short
            return 0
        fi
        printf "."
        sleep 2
        retries=$((retries + 1))
    done
    echo
    warn "API not responding yet — check logs with 'noa logs noa-api'"
}

cmd_down() {
    # Guard against accidental volume deletion (destroys all user data)
    for arg in "$@"; do
        if [[ "$arg" == "-v" || "$arg" == "--volumes" ]]; then
            warn "The -v/--volumes flag will DELETE ALL DATA (users, settings, conversations)."
            echo -n "Are you sure? [y/N] "
            read -r confirm
            if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
                log "Aborted."
                return 0
            fi
            break
        fi
    done
    log "Stopping Noa..."
    docker compose down "$@"
    ok "All services stopped"
}

cmd_restart() {
    local service="${1:-}"
    if [[ -n "$service" ]]; then
        log "Restarting ${service}..."
        docker compose restart "$service"
    else
        log "Restarting all services..."
        docker compose restart
    fi
    ok "Restart complete"
}

cmd_status_short() {
    echo
    docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || docker compose ps
}

cmd_status() {
    log "Service status:"
    cmd_status_short
    echo
    log "Health checks:"
    if curl -sf http://localhost:8000/health &>/dev/null; then
        local ready
        ready=$(curl -sf http://localhost:8000/health/ready 2>/dev/null || echo '{"status":"unreachable"}')
        ok "API: ${ready}"

        local metrics
        metrics=$(curl -sf http://localhost:8000/health/metrics 2>/dev/null || echo '{}')
        ok "Metrics: ${metrics}"
    else
        warn "API not reachable at localhost:8000"
    fi
}

cmd_logs() {
    local service="${1:-}"
    if [[ -n "$service" ]]; then
        docker compose logs -f --tail=100 "$service"
    else
        docker compose logs -f --tail=50
    fi
}

cmd_health() {
    log "Running health checks..."
    echo
    if curl -sf http://localhost:8000/health &>/dev/null; then
        ok "API liveness: alive"
    else
        err "API liveness: unreachable"
    fi

    local ready
    ready=$(curl -sf http://localhost:8000/health/ready 2>/dev/null)
    if [[ $? -eq 0 ]]; then
        ok "API readiness: ${ready}"
    else
        err "API readiness: failed"
    fi

    local tools
    tools=$(curl -sf http://localhost:8000/health/tools 2>/dev/null)
    if [[ $? -eq 0 ]]; then
        ok "Tool health: ${tools}"
    else
        warn "Tool health: unavailable"
    fi

    echo
    log "Container health:"
    docker compose ps --format "table {{.Name}}\t{{.Status}}"
}

cmd_backup() {
    log "Triggering manual backup..."
    docker compose exec backup /scripts/backup.sh
    ok "Backup complete"
}

cmd_test() {
    log "Running test suite..."
    python -m pytest tests/ -v "$@"
}

cmd_shell() {
    local service="${1:-noa-api}"
    log "Opening shell in ${service}..."
    docker compose exec "$service" /bin/sh
}

cmd_dev() {
    log "Starting Noa in dev mode (backend + Vite UI)..."

    # Pre-flight (loads Keychain secrets)
    if ! preflight; then
        err "Pre-flight failed. Run 'noa setup' first."
        exit 1
    fi
    echo

    # Check node/npm
    if ! command -v npm &>/dev/null; then
        err "npm not found — install Node.js first"
        exit 1
    fi

    # Install web deps if needed
    if [[ ! -d "$NOA_DIR/web/node_modules" ]]; then
        log "Installing web dependencies..."
        (cd "$NOA_DIR/web" && npm install)
        ok "Web dependencies installed"
    fi

    sync_postgres_password

    # Start backend containers (without web — it runs on host)
    # dev-api override publishes port 8000 to localhost so Vite proxy can reach it
    log "Starting backend containers..."
    docker compose -f docker-compose.yml -f docker-compose.dev-api.yml up -d
    echo

    # Wait for API
    log "Waiting for API..."
    local retries=0
    local api_ready=false
    while [[ $retries -lt 30 ]]; do
        if curl -sf http://localhost:8000/health &>/dev/null; then
            api_ready=true
            break
        fi
        printf "."
        sleep 2
        retries=$((retries + 1))
    done
    echo

    if [[ "$api_ready" != "true" ]]; then
        warn "API not responding at localhost:8000 — check: noa logs noa-api"
    fi

    # Run migrations
    log "Running database migrations..."
    if docker compose exec -T noa-api alembic upgrade head &>/dev/null; then
        ok "Database migrations up to date"
    else
        warn "Migrations failed — run 'noa db migrate' manually"
    fi

    echo
    ok "Backend running at ${BOLD}http://localhost:8000${NC}"
    ok "Starting Vite dev server with hot reload..."
    echo

    # Start Vite in foreground (Ctrl+C stops it, backend keeps running)
    # BASE_URL stays empty — Vite proxy handles /api → http://localhost:8000
    (cd "$NOA_DIR/web" && npm run dev)

    # When Vite exits (Ctrl+C), offer to stop backend too
    echo
    warn "Vite stopped. Backend containers are still running."
    echo -e "  Stop everything: ${BOLD}noa down${NC}"
}

cmd_reset_password() {
    local email="${1:-}"
    if [[ -z "$email" ]]; then
        echo "Usage: noa reset-password <email> [new-password]"
        echo "  If no password given, one will be generated."
        return 1
    fi

    local new_password="${2:-}"
    if [[ -z "$new_password" ]]; then
        new_password=$(openssl rand -base64 16)
        log "Generated password: ${BOLD}${new_password}${NC}"
    fi

    log "Resetting password for ${email}..."

    # Detect which stack is running: dev-full (noa-api-dev) or production (noa-api)
    local docker_exec_cmd
    if docker inspect noa-api-dev &>/dev/null 2>&1; then
        docker_exec_cmd="docker exec -i noa-api-dev"
    else
        docker_exec_cmd="docker compose exec -T noa-api"
    fi

    # Hash password and update DB via the API container's Python
    local result
    result=$($docker_exec_cmd python3 -c "
import asyncio, os
from noa.auth.password import hash_password
from sqlalchemy import text
from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession

async def reset():
    url = os.environ['DATABASE_URL']
    engine = create_async_engine(url)
    factory = async_sessionmaker(engine, class_=AsyncSession)
    async with factory() as session:
        pw_hash = hash_password('$new_password')
        result = await session.execute(
            text('UPDATE users SET password_hash = :h WHERE email = :e'),
            {'h': pw_hash, 'e': '$email'},
        )
        await session.commit()
        print(f'ROWS:{result.rowcount}')
    await engine.dispose()

asyncio.run(reset())
" 2>&1)

    if echo "$result" | grep -q "ROWS:0"; then
        err "No user found with email: ${email}"
    elif echo "$result" | grep -q "ROWS:"; then
        ok "Password reset for ${email}"
    else
        err "Failed: ${result}"
    fi
}

cmd_claude() {
    local subcmd="${1:-run}"
    case "$subcmd" in
        build)
            log "Rebuilding dev container (updates Claude Code to latest)..."
            docker compose -f docker-compose.dev.yml build --no-cache
            ok "Dev container rebuilt with latest Claude Code"
            # Show installed version
            docker compose -f docker-compose.dev.yml run --rm dev cat /etc/claude-code-version 2>/dev/null || true
            ;;
        run|"")
            log "Starting Claude Code in dev container..."
            log "Policy: docs/DEV_CONTAINER_POLICY.md"
            echo

            # Pass ANTHROPIC_API_KEY from host Keychain to container
            local api_key
            api_key=$(security find-generic-password -s "noa" -a "ANTHROPIC_API_KEY" -w 2>/dev/null) || true
            if [[ -z "$api_key" ]]; then
                warn "ANTHROPIC_API_KEY not in Keychain — Claude Code may not authenticate"
                warn "Set it with: ./tools/keychain_store.sh set ANTHROPIC_API_KEY <key>"
            fi

            ANTHROPIC_API_KEY="${api_key:-}" \
                docker compose -f docker-compose.dev.yml run --rm \
                --service-ports \
                dev claude
            ;;
        *)
            echo "Usage: noa claude [build|run]"
            echo "  run    Start Claude Code in dev container (default)"
            echo "  build  Rebuild dev container (updates Claude Code)"
            ;;
    esac
}

cmd_db() {
    local subcmd="${1:-}"
    case "$subcmd" in
        migrate)
            log "Running database migrations..."
            docker compose exec noa-api alembic upgrade head
            ok "Migrations complete"
            ;;
        console)
            log "Opening psql console..."
            docker compose exec postgres psql -U noa -d noa
            ;;
        *)
            echo "Usage: noa db [migrate|console]"
            ;;
    esac
}

cmd_dev_full() {
    local subcmd="${1:-up}"
    local compose="docker compose -f docker-compose.dev-full.yml"

    case "$subcmd" in
        up|workers)
            log "Starting dev-full stack..."
            if ! preflight; then
                err "Pre-flight failed. Run 'noa setup' first."
                exit 1
            fi
            echo

            # Ensure the named postgres volume exists (survives 'down -v')
            if ! docker volume inspect noa-dev-pgdata &>/dev/null; then
                log "Creating persistent postgres volume..."
                docker volume create noa-dev-pgdata
                ok "Volume noa-dev-pgdata created"
            fi

            if [[ "$subcmd" == "workers" ]]; then
                log "Including private-worker + external-worker"
                $compose --profile workers up -d
            else
                $compose up -d
            fi

            echo
            log "Waiting for API..."
            local retries=0
            while [[ $retries -lt 30 ]]; do
                if curl -sf http://localhost:8000/health &>/dev/null; then
                    echo
                    ok "Dev-full stack running at ${BOLD}http://localhost:8000${NC}"
                    $compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || $compose ps
                    return 0
                fi
                printf "."
                sleep 2
                retries=$((retries + 1))
            done
            echo
            warn "API not responding — check: $compose logs noa-api-dev"
            ;;
        down)
            log "Stopping dev-full stack..."
            $compose --profile workers down
            ok "Dev-full stack stopped"
            ;;
        build)
            log "Rebuilding dev-full images..."
            $compose --profile workers build
            ok "Dev-full images rebuilt"
            ;;
        *)
            echo "Usage: noa dev-full [workers|down|build]"
            echo "  (no arg)   Start dev + postgres + API"
            echo "  workers    Same + private-worker + external-worker"
            echo "  down       Stop all dev-full services"
            echo "  build      Rebuild all dev-full images"
            ;;
    esac
}

# ── Main ─────────────────────────────────────────────────────────

# Always load Keychain first — docker compose needs env vars even for
# read-only commands like 'logs', 'ps', 'down' due to ${VAR:?} syntax
load_keychain 2>/dev/null || true

cmd_keys() {
    echo "Keychain secrets for Noa:"
    for pair in "${KEYCHAIN_MAP[@]}"; do
        local kc_name="${pair%%:*}"
        local val
        val=$(security find-generic-password -s "noa" -a "$kc_name" -w 2>/dev/null) || true
        if [[ -n "$val" ]]; then
            echo -e "  ${GREEN}✓${NC} $kc_name = ${val:0:6}…"
        else
            echo -e "  ${RED}✗${NC} $kc_name (not set)"
        fi
    done
}

cmd_db_migrate_volume() {
    # One-time migration: copy data from old auto-named postgres volume to the
    # new explicitly-named volume (noa-dev-pgdata / noa-pgdata).
    local mode="${1:-dev}"
    local new_vol old_vol

    if [[ "$mode" == "prod" ]]; then
        new_vol="noa-pgdata"
    else
        new_vol="noa-dev-pgdata"
    fi

    # Find old volume(s) containing postgres data
    log "Searching for old postgres volumes..."
    local candidates
    candidates=$(docker volume ls -q | grep -i postgres | grep -v "^${new_vol}$" || true)

    if [[ -z "$candidates" ]]; then
        err "No old postgres volumes found. Nothing to migrate."
        echo "Existing volumes:"
        docker volume ls -q | grep -i postgres || echo "  (none)"
        return 1
    fi

    echo "Found candidate volumes:"
    local i=0
    local vols=()
    while IFS= read -r vol; do
        i=$((i + 1))
        vols+=("$vol")
        # Show creation time and size
        local info
        info=$(docker volume inspect "$vol" --format '{{.CreatedAt}}' 2>/dev/null || echo "unknown")
        echo "  ${i}) ${vol}  (created: ${info})"
    done <<< "$candidates"

    if [[ ${#vols[@]} -eq 1 ]]; then
        old_vol="${vols[0]}"
        log "Using: ${old_vol}"
    else
        echo -n "Which volume to migrate from? [1-${#vols[@]}] "
        read -r choice
        if [[ -z "$choice" || "$choice" -lt 1 || "$choice" -gt ${#vols[@]} ]] 2>/dev/null; then
            err "Invalid choice"; return 1
        fi
        old_vol="${vols[$((choice - 1))]}"
    fi

    # Ensure new volume exists
    docker volume create "$new_vol" &>/dev/null

    # Ensure no containers are using either volume
    log "Stopping any running containers..."
    docker compose -f docker-compose.dev-full.yml --profile workers down &>/dev/null || true

    # Copy data using a temporary container
    log "Copying data from ${old_vol} → ${new_vol}..."
    if docker run --rm \
        -v "${old_vol}:/from:ro" \
        -v "${new_vol}:/to" \
        alpine sh -c "cp -a /from/. /to/"; then
        ok "Data migrated successfully"
        echo
        warn "Old volume '${old_vol}' still exists. Remove it manually after verifying:"
        echo "  docker volume rm ${old_vol}"
    else
        err "Migration failed"
        return 1
    fi
}

cmd_set() {
    local key="${1:-}"
    local value="${2:-}"
    if [[ -z "$key" || -z "$value" ]]; then
        echo "Usage: ./noa set <KEY_NAME> <value>" >&2
        exit 1
    fi
    ./tools/keychain_store.sh set "$key" "$value"
    ok "Stored $key in Keychain"
}

cmd="${1:-up}"
shift 2>/dev/null || true

case "$cmd" in
    up|start)       cmd_up ;;
    down|stop)      cmd_down ;;
    restart)        cmd_restart "$@" ;;
    status|ps)      cmd_status ;;
    logs|log)       cmd_logs "$@" ;;
    health|check)   cmd_health ;;
    backup)         cmd_backup ;;
    test)           cmd_test "$@" ;;
    preflight)      preflight ;;
    setup|init)     cmd_setup ;;
    dev)            cmd_dev ;;
    dev-full)       cmd_dev_full "$@" ;;
    keys)           cmd_keys ;;
    set)            cmd_set "$@" ;;
    reset-password) cmd_reset_password "$@" ;;
    shell|exec)     cmd_shell "$@" ;;
    claude)         cmd_claude "$@" ;;
    db)             cmd_db "$@" ;;
    migrate-volume) cmd_db_migrate_volume "$@" ;;
    help|-h|--help) usage ;;
    *)
        err "Unknown command: ${cmd}"
        usage
        exit 1
        ;;
esac
