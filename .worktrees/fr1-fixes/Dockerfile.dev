# Noa Dev Container — Claude Code development environment
# Policy: docs/DEV_CONTAINER_POLICY.md
# Security: SPEC.md §2.4, §8
#
# Rebuild to update Claude Code:
#   docker compose -f docker-compose.dev.yml build --no-cache

FROM python:3.11-slim

# System dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git curl ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 LTS (required for Claude Code)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Claude Code — update by rebuilding the image
RUN npm install -g @anthropic-ai/claude-code@latest \
    && echo "claude-code $(claude --version 2>/dev/null || echo 'installed')" > /etc/claude-code-version

# Non-root user (§8.1: dedicated non-root user inside container)
RUN groupadd -g 1000 devuser \
    && useradd -m -u 1000 -g devuser -s /bin/bash devuser

# Bash config: no secrets in shell history, audit logging
RUN echo 'export HISTIGNORE="*SECRET*:*KEY*:*PASSWORD*:*TOKEN*:*PASSPHRASE*"' >> /etc/bash.bashrc \
    && echo 'export HISTCONTROL=ignoreboth:erasedups' >> /etc/bash.bashrc \
    && echo 'shopt -s histappend' >> /etc/bash.bashrc

WORKDIR /workspace

# Pre-install Python dependencies at build time (container is read_only at runtime)
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir ".[dev,api,orchestrator]" \
    && rm -rf /root/.cache

USER devuser

CMD ["bash"]
