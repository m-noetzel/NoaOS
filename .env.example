# Noa Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── Core ─────────────────────────────────────────────────────────
# Environment: development | production | testing
NOA_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://noa:noa@postgres:5432/noa
POSTGRES_PASSWORD=change-me-in-production

# Security (REQUIRED in production)
SECRET_KEY=dev-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=90

# ── LLM Providers (at least one required for external domain) ────
# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT-4) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI (Gemini) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ── Tool Integrations (optional) ─────────────────────────────────
# Google Calendar + Gmail — OAuth 2.0 credentials
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion — https://www.notion.so/my-integrations
NOTION_TOKEN=

# Web Search (Tavily) — https://tavily.com/
TAVILY_API_KEY=

# ── Infrastructure (optional) ────────────────────────────────────
# Backup encryption passphrase
BACKUP_PASSPHRASE=

# TLS domain (production only)
NOA_DOMAIN=localhost
NOA_ACME_EMAIL=
